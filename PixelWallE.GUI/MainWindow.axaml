<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PixelWallE.GUI.ViewModels"
    x:Class="PixelWallE.GUI.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Title="PixelWallE"
    Width="1000" Height="700"
    MinWidth="800"
    MinHeight="600">

    <DockPanel Margin="10">

        <!-- Toolbar superior -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Spacing="10">
            <Button Content="Ejecutar" Command="{Binding RunCommand}" Width="80"/>
            <Button Content="Cargar .pw" Command="{Binding LoadCommand}" Width="100"/>
            <Button Content="Guardar .pw" Command="{Binding SaveCommand}" Width="100"/>
            <TextBox Width="80" Text="{Binding CanvasSizeStr}" Watermark="Tamaño"/>
            <Button Content="Redimensionar" Command="{Binding ResizeCommand}" Width="120"/>
        </StackPanel>

        <!-- División del contenido -->
        <Grid ColumnDefinitions="2*,Auto,3*" Margin="0,10,0,0">
            
            <!-- Editor de Código -->
            <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                <ScrollViewer Name="LineScrollViewer" VerticalScrollBarVisibility="Hidden">
                    <TextBlock Name="LineNumbers"
                               FontFamily="Consolas"
                               FontSize="14"
                               Margin="4"
                               Foreground="Gray"
                               TextWrapping="NoWrap"/>
                </ScrollViewer>
                <TextBox Grid.Column="1"
                         Name="CodeEditor"
                         FontFamily="Consolas"
                         FontSize="14"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Text="{Binding Code, Mode=TwoWay}" />
            </Grid>

            <!-- Separador visual -->
            <Rectangle Grid.Column="1" Width="1" Fill="Gray"/>

            <!-- Canvas de píxeles -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="CanvasGrid"
                      Background="White"
                      Margin="10"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </ScrollViewer>

        </Grid>
    </DockPanel>
</Window>
