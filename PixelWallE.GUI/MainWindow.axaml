<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:avalon="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:document="clr-namespace:AvaloniaEdit.Document;assembly=AvaloniaEdit"
        xmlns:gui="clr-namespace:PixelWallE.GUI"
        x:Class="PixelWallE.GUI.MainWindow"
        Title="PixelWallE"
        Width="1000" Height="600">
    
    <Grid Background="#FFE8E8E8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Panel de botones -->
            <RowDefinition Height="*"/>    <!-- Contenido principal -->
        </Grid.RowDefinitions>

        <!-- NUEVO: Panel superior de botones -->
        <Border Grid.Row="0" Background="#FFD3D3D3" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <!-- Controles de dimensión -->
                <TextBlock Text="Tamaño canvas:" VerticalAlignment="Center"/>
                <TextBox Name="SizeInput" Width="50" Text="50"/>
                <TextBlock Text="Tamaño px:" VerticalAlignment="Center"/>
                <TextBox Name="PixelSizeInput" Width="50" Text="20"/>
                <Button Name="ResizeButton" Content="Aplicar Cambios" MinWidth="100" Click="OnResizeClick"/>
                <Button Name="GridButton" Content="Cuadrículas: ON" MinWidth="100" Click="OnGridClick"/>
                <!-- Botones de ejecución -->
                <Button Name="RunButton" Content="Ejecutar" MinWidth="80" Margin="20,0,0,0" Click="OnRunClick"/>
                
                <!-- Botones de archivo -->
                <Button Name="LoadButton" Content="Cargar" MinWidth="80" Click="OnLoadClick"/>
                <Button Name="SaveButton" Content="Guardar" MinWidth="80" Click="OnSaveClick"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/> <!-- Editor -->
                <ColumnDefinition Width="5"/> <!-- Divisor -->
                <ColumnDefinition Width="*"/> <!-- Canvas -->
            </Grid.ColumnDefinitions>
            
            <!-- Editor de código con números de línea integrados -->
            <avaloniaEdit:TextEditor Grid.Column="0" Name="CodeEditor"
                                   FontFamily="Consolas" FontSize="14"
                                   ShowLineNumbers="True"
                                   LineNumbersForeground="Gray"
                                   WordWrap="False"
                                   SyntaxHighlighting="C#"
                                   HorizontalScrollBarVisibility="Visible"
                                   VerticalScrollBarVisibility="Visible"
                                   Background="#F0F0F0">
                <avaloniaEdit:TextEditor.Document>
                    <document:TextDocument Text="Spawn(0,0)"/>
                </avaloniaEdit:TextEditor.Document>
            </avaloniaEdit:TextEditor>
            
            <!-- Divisor -->
            <GridSplitter Grid.Column="1" Width="5" Background="Gray"/>
            
            <!-- Canvas de píxeles -->
            <Border Grid.Column="2" Margin="10" Background="White" BorderBrush="Gray" BorderThickness="1">
                <ScrollViewer x:Name="CanvasScrollViewer" 
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Auto">
                    <gui:PixelCanvas x:Name="PixelCanvasControl"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>